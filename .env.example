PORT=5000
MONGO_URI=mongodb://localhost:27017/food_ninja
JWT_SECRET=your_jwt_secret_here

# SMS OTP provider: arkesel (default) or twilio. OTP_CONSOLE=true prints codes instead (dev only).
SMS_PROVIDER=arkesel
OTP_CONSOLE=false
# Dev only: every OTP and reset code is this 4-digit value and nothing is sent.
# Ignored when NODE_ENV=production. Leave empty for real random codes.
OTP_DEV_CODE=
# Android autofill hash from the app's log; optional
SMS_APP_HASH=

# Arkesel. Sender ID is 3-11 chars and must be approved in the Arkesel dashboard.
ARKESEL_API_KEY=your_arkesel_api_key
SMS_SENDER_ID=YumQuick

# Twilio (only when SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Nodemailer (email OTP)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
